AGENT_SPRING_PROFILES_ACTIVE=prod

# ─── Database (PostgreSQL + pgvector) ──────────
AGENT_DB_HOST=postgres
AGENT_DB_PORT=5432
AGENT_DB_NAME=agent-service
AGENT_DB_USERNAME=agent_agent
AGENT_DB_PASSWORD=change_me

# ─── Redis (Short-term ChatMemory) ─────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Agent Memory & pgvector ───────────────────
AGENT_MEMORY_MAX_MESSAGES=20
AGENT_MEMORY_SESSION_TTL_MINUTES=45
AGENT_MEMORY_MIN_SCORE=0.68
AGENT_MEMORY_RAG_MAX_RESULTS=5

PGVECTOR_ENABLED=true
PGVECTOR_TABLE=agent_long_term_memory
PGVECTOR_DIMENSION=1536
PGVECTOR_USE_INDEX=false
PGVECTOR_INDEX_LIST_SIZE=100
PGVECTOR_CREATE_TABLE=true
PGVECTOR_DROP_TABLE_FIRST=false

# ─── MinIO ─────────────────────────────────────
STORAGE_MINIO_ROOT_USER=change_me
STORAGE_MINIO_ROOT_PASSWORD=change_me
STORAGE_MINIO_ENDPOINT=http://minio:9000
STORAGE_MINIO_DEFAULT_BUCKET=agentic-cloud-storage

# ─── Kafka ─────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9094
STORAGE_MINIO_EVENTS_TOPIC=minio.events.object-created

# ─── OpenAI / LLM ──────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
