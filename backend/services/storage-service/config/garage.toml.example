metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "mysql"
replication_factor = 1

# RPC Configuration
rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "your-super-secret-32-bytes-hex-string"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage.localhost"
advertise_endpoint = "http://s3.garage.localhost:3900"

[s3_web]
bind_addr = "[::]:3902"
root_domain = ".web.garage.localhost"
index = "index.html"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "your-super-secret-32-bytes-base64-string"
metrics_token = "your-super-secret-32-bytes-base64-string"